+static void read_bar_addr(struct pci_dev *pdev, int bar_offset, u64 *addr,
+			  bool *is_64bit)
+{
+	u32 bar_lo, bar_hi = 0;
+
+	pci_read_config_dword(pdev, bar_offset, &bar_lo);
+
+	*is_64bit = ((bar_lo & PCI_BASE_ADDRESS_MEM_TYPE_MASK) ==
+		     PCI_BASE_ADDRESS_MEM_TYPE_64);
+
+	if (*is_64bit) {
+		pci_read_config_dword(pdev, bar_offset + 4, &bar_hi);
+		*addr = ((u64)bar_hi << 32) |
+			(bar_lo & PCI_BASE_ADDRESS_MEM_MASK);
+	} else {
+		*addr = bar_lo & PCI_BASE_ADDRESS_MEM_MASK;
+	}
+}
+
+static void __maybe_unused read_root_port(struct pci_dev *dev, u64 *base,
+					  u64 *limit)
+{
+	struct pci_dev *root = pci_upstream_bridge(dev);
+
+	pr_info("Found bridge: %02x:%02x.%d\n", root->bus->number,
+		PCI_SLOT(root->devfn), PCI_FUNC(root->devfn));
+
+	u16 base_lower, limit_lower;
+	u32 base_upper, limit_upper;
+
+	pci_read_config_word(root, PCI_PREF_MEMORY_BASE, &base_lower);
+	pci_read_config_dword(root, PCI_PREF_BASE_UPPER32, &base_upper);
+	pci_read_config_word(root, PCI_PREF_MEMORY_LIMIT, &limit_lower);
+	pci_read_config_dword(root, PCI_PREF_LIMIT_UPPER32, &limit_upper);
+
+	pr_info("read values for lower base:limit: %hx:%hx\n", base_lower,
+		limit_lower);
+	*base = (((u64)base_upper) << 32) | (((u64)base_lower) << 16);
+	*limit = (((u64)limit_upper) << 32) | (((u64)limit_lower) << 16);
+}
+static void __maybe_unused reconfig_root_port(struct pci_dev *dev, u64 base,
+					      u64 limit)
+{
+	struct pci_dev *root = pci_upstream_bridge(dev);
+
+	pci_write_config_word(root, PCI_PREF_MEMORY_BASE, base >> 16);
+	pci_write_config_dword(root, PCI_PREF_BASE_UPPER32, base >> 32);
+	pci_write_config_word(root, PCI_PREF_MEMORY_LIMIT, limit >> 16);
+	pci_write_config_dword(root, PCI_PREF_LIMIT_UPPER32, limit >> 32);
+}
+
+static void write_bar_addr(struct pci_dev *pdev, int bar_offset, u64 new_addr,
+			   bool is_64bit)
+{
+	u16 cmd;
+	u32 bar_lo;
+
+	pci_read_config_dword(pdev, bar_offset, &bar_lo);
+
+	pci_read_config_word(pdev, PCI_COMMAND, &cmd);
+	pci_write_config_word(pdev, PCI_COMMAND, cmd & ~PCI_COMMAND_MEMORY);
+
+	pci_write_config_dword(pdev, bar_offset,
+			       (u32)(new_addr & 0xFFFFFFF0) | (bar_lo & 0xF));
+
+	if (is_64bit)
+		pci_write_config_dword(pdev, bar_offset + 4,
+				       (u32)(new_addr >> 32));
+
+	pci_write_config_word(pdev, PCI_COMMAND, cmd);
+}
