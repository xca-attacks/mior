+static void read_mmiobase(uint32_t instance_id, uint32_t min, uint32_t count)
+{
+	uint32_t base_reg = 0xd80;
+
+	u32 *bases = kmalloc(sizeof(u32) * count, GFP_KERNEL);
+	u32 *limits = kmalloc(sizeof(u32) * count, GFP_KERNEL);
+	MmioAddressControl *address_controls =
+		kmalloc(sizeof(MmioAddressControl) * count, GFP_KERNEL);
+	MmioExtAddress *extended_addresses =
+		kmalloc(sizeof(MmioExtAddress) * count, GFP_KERNEL);
+
+	if (!bases | !limits | !address_controls | !extended_addresses) {
+		goto out;
+	}
+
+	int non_null = false;
+
+	// for (int instance_id = 0; instance_id < 0x60; instance_id++) {
+	for (uint32_t i = min; i < count; i++) {
+		uint32_t mmio_base_reg = base_reg + 16 * i;
+		uint32_t mmio_limit_reg = mmio_base_reg + 4;
+		uint32_t mmio_control_reg = mmio_base_reg + 8;
+		uint32_t mmio_extended_reg = mmio_base_reg + 12;
+
+		df_indirect_read(0, 0x0, mmio_base_reg, instance_id, &bases[i]);
+		df_indirect_read(0, 0x0, mmio_limit_reg, instance_id,
+				 &limits[i]);
+		df_indirect_read(0, 0x0, mmio_control_reg, instance_id,
+				 &address_controls[i].value);
+		df_indirect_read(0, 0x0, mmio_extended_reg, instance_id,
+				 &extended_addresses[i].value);
+
+		if (bases[i] || limits[i])
+			non_null = true;
+	}
+
+	if (!non_null) {
+		pr_info("Instance ID: 0x%02x | all 0\n", instance_id);
+	}
+
+	for (uint32_t i = min; non_null && i < count; i++) {
+		uint32_t mmio_base_reg = base_reg + 16 * i;
+		uint32_t mmio_extended_reg = mmio_base_reg + 12;
+
+		u32 base, limit;
+		MmioAddressControl address_control;
+		MmioExtAddress extended_address;
+		base = bases[i];
+		limit = limits[i];
+		address_control = address_controls[i];
+		extended_address = extended_addresses[i];
+
+#ifndef MINIMAL
+		pr_info("Instance ID: 0x%02x | Registers: %02x-%02x | Config = {",
+			instance_id, mmio_base_reg, mmio_extended_reg);
+		pr_cont("\n\tbase: %08x", base);
+
+		pr_cont("\n\tlimit: %08x", limit);
+
+		pr_cont("\n\taddress_control: { RE: %s, WE: %s, CpuDis: %s, NP: %s, "
+			"reserved: 0x%03x, DstFabricID: 0x%03x, reserved: 0x%01x }",
+			TF(address_control.RE), TF(address_control.WE),
+			TF(address_control.CpuDis), TF(address_control.NP),
+			address_control.reserved1, address_control.DstFabricID,
+			address_control.reserved2);
+
+		pr_cont("\n\textended: { BaseExt: 0x%02x, reserved: 0x%02x, LimitExt: "
+			"0x%02x, reserved: 0x%02x }",
+			extended_address.MmioBaseAddrExt,
+			extended_address.reserved1,
+			extended_address.MmioLimitAddrExt,
+			extended_address.reserved2);
+
+		pr_cont("\n}\n");
+
+#else
+		pr_info("Instance ID: 0x%02x | Registers: %02x-%02x | Base=%08x | Limit = "
+			"%08x\n",
+			instance_id, mmio_base_reg, mmio_limit_reg, base,
+			limit);
+
+#endif /* ifndef MINIMAL */
+	}
+
+out:
+	kfree(bases);
+	kfree(limits);
+	kfree(address_controls);
+	kfree(extended_addresses);
+}
